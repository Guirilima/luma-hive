{
  "name": "luma-hive",
  "version": "0.1.0",
  "private": true,
  "description": "Local agent workspace — Angular 20, Node.js and SQLite",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "ng build && tsc -p apps/api/tsconfig.json",
    "build:web": "ng build",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "typecheck": "tsc -p apps/web/tsconfig.app.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node tests/ui-smoke.mjs",
    "format": "prettier --write apps packages scripts tests *.json *.md docs",
    "format:check": "prettier --check apps packages scripts tests *.json *.md docs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@angular/common": "~20.3.33",
    "@angular/compiler": "~20.3.33",
    "@angular/core": "~20.3.33",
    "@angular/forms": "~20.3.33",
    "@angular/platform-browser": "~20.3.33",
    "@angular/router": "~20.3.33",
    "better-sqlite3": "^13.0.3",
    "rxjs": "~7.8.2",
    "three": "~0.180.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~20.3.39",
    "@angular/cli": "~20.3.39",
    "@angular/compiler-cli": "~20.3.33",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/three": "~0.180.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "@playwright/test": "^1.56.0",
    "prettier": "^3.6.2"
  }
}
